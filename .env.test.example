# Copy to .env.test (git-ignored) to run the cloud suites against real accounts.
# Each provider's suite runs only when its settings are present.
# For local emulators instead, use `npm run emulators:start && npm run test:emulators`.

AWS_BUCKET_NAME=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT=

AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET_NAME=
GOOGLE_CLOUD_KEY_FILENAME=
